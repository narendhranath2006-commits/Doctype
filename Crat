function updateChart() {

    let labels = workoutList.map(item => item.workout);
    let calories = workoutList.map(item => Number(item.calories));

    if (chart) {
        chart.destroy();
    }

    const ctx = document.getElementById("workoutChart");

    chart = new Chart(ctx, {
        type: "bar",
        data: {
            labels: labels,
            datasets: [{
                label: "Calories Burned",
                data: calories
            }]
        },
        options: {
            responsive: true
        }
    });
}

function displayWorkouts() {
    let list = document.getElementById("workoutList");
    list.innerHTML = "";

    workoutList.forEach((item, index) => {
        let li = document.createElement("li");

        li.innerHTML = `
            ${item.workout} - ${item.duration} Min - ${item.calories} Calories
            <button onclick="deleteWorkout(${index})">Delete</button>
        `;

        list.appendChild(li);
    });
}
